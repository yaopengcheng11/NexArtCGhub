# ============================================================
# CG Resource Hub 生产环境变量样例
# 复制本文件为 .env 并填好真实值,docker compose 会自动读取
# ============================================================

# 监听端口(宿主机端口,改成 80 可让外部直接访问,但建议走 Nginx 反代)
APP_PORT=8788

# CORS,生产环境改成实际域名
CORS_ORIGIN=*

# 必填:随机长字符串,openssl rand -hex 64 生成
JWT_SECRET=

# 初始管理员账号(首次启动时会自动 seed 到 SQLite)
admin_USERNAME=admin
admin_PASSWORD=

# 在线工具路径(不跑 Houdini 工具可留空)
HOUDINI_PATH=
BLENDER_PATH=
PYTHON_PATH=python3

# 上传 / 任务超时(默认够用)
MAX_UPLOAD_MB=50
HYTHON_TIMEOUT_MS=600000
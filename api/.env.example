# =====================================================================
# CG Resource Hub — API environment
# Copy this file to `.env` (the real config) and fill in your values.
# `.env` is git-ignored.
# =====================================================================

# --- Server ---
PORT=8788
NODE_ENV=development

# Set TRUST_PROXY=1 when the API runs behind a tunnel / reverse proxy
# (ngrok, cloudflared, Nginx). Makes Express honor X-Forwarded-For so the
# per-IP rate limiters see real client IPs instead of 127.0.0.1 for
# everyone. Leave unset when clients connect directly.
#TRUST_PROXY=0

# Canonical public origin (scheme + host, no trailing slash) used in
# Stripe success/cancel redirect URLs. REQUIRED in production — the API
# refuses to build redirects from the Host header (a spoofed Host would
# send paid users to an attacker origin). Dev falls back to the request
# origin when unset.
#PUBLIC_ORIGIN=https://your-domain.example

# Where the BROWSER lands after paying (SPA origin), when the frontend
# runs on a different port than this API in dev (vite :5173 vs API :8789).
# Alipay return_url / Stripe success_url / mock cashier redirects use it;
# webhook notify URLs always stay on the API origin. Production leaves it
# unset (PUBLIC_ORIGIN already points at the SPA).
#FRONTEND_ORIGIN=http://127.0.0.1:5173

# --- CORS ---
# Comma-separated list of origins allowed to call this API in dev.
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# Long random string. Used to sign JWTs and to sign HDA download URLs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED at boot — the API refuses to start if this is missing, shorter
# than 32 chars, or contains the placeholder text 'change_me'/'fallback'.
JWT_SECRET=

# --- Invites ---
# Invite code required to register. REQUIRED in production — if unset the
# API refuses to boot rather than fall back to a public default (a shipped
# default would make registration public). Dev keeps a fixed fallback.
INVITE_CODE=ethereal-2026

# --- Houdini path doctor tool ---
# Path to the bundled hython executable (Houdini 22.0.368).
HYTHON_PATH=C:\Program Files\Side Effects Software\Houdini 22.0.368\bin\hython.exe
HIP_PATH_DOCTOR_MAX_BYTES=104857600   # 100 MB

# --- Stripe (online payments) ---
# Sign up at https://dashboard.stripe.com/register, toggle to "Test mode",
# then copy keys from https://dashboard.stripe.com/test/apikeys
#
# 1. Get your SECRET key (sk_test_...)  → STRIPE_SECRET_KEY
# 2. Get your PUBLISHABLE key (pk_test_...)  → STRIPE_PUBLISHABLE_KEY
# 3. Add a webhook endpoint pointing to https://<your-host>/api/webhooks/stripe
#    listening for `checkout.session.completed` events, then copy the
#    signing secret (whsec_...)  → STRIPE_WEBHOOK_SECRET
#
# For local testing, use the Stripe CLI to forward webhooks:
#   stripe listen --forward-to http://localhost:8788/api/webhooks/stripe
#   (it prints a whsec_... signing secret to use)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe: regional payment methods (Option A: unified Stripe) ---
# If you used Stripe Atlas to incorporate a US LLC, you can accept both
# card payments (international) and WeChat Pay / Alipay (Chinese customers
# paying cross-border). CNY prices are shown to users whose UI is in
# Chinese; USD for everyone else.
#
# Setup (one-time, in Stripe Dashboard):
#   1. Settings → Payment methods → Activate "WeChat Pay"
#   2. Settings → Payment methods → Activate "Alipay"
#   3. Both support CNY + 10 other currencies; no code change needed.
#
# If STRIPE_SECRET_KEY is empty, all /api/checkout/* routes return 503.
# No additional env vars needed; the currency is chosen by the frontend
# (driven by the i18n locale: 'zh' → CNY, 'en' → USD).

# --- Alipay 电脑网站支付 (mainland-China direct, CNY checkout) ---
# Sign up at https://open.alipay.com — needs a 企业/个体工商户 account with
# the "电脑网站支付" product signed. Create a self-built app, then:
#   1. AppID                                → ALIPAY_APP_ID
#   2. 应用私钥 (PKCS8, from the key tool)   → ALIPAY_PRIVATE_KEY
#   3. 支付宝公钥 (NOT your app public key — the one shown under
#      "接口加签方式" after you set the app public key) → ALIPAY_PUBLIC_KEY
#   4. In the open platform, set the async notify address per-request (we
#      send it as notify_url); no fixed webhook config needed there.
#
# Once set, Chinese-locale users pay through Alipay directly (rmb settles
# to your domestic account) — Stripe is no longer used for CNY.
# Optional: point ALIPAY_GATEWAY at the sandbox while integrating.
#ALIPAY_APP_ID=
#ALIPAY_PRIVATE_KEY=
#ALIPAY_PUBLIC_KEY=
#ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# --- WeChat Pay v3 · Native 扫码支付 (mainland-China direct, CNY) ---
# Apply at https://pay.weixin.qq.com (企业/个体工商户 merchant account),
# enable "Native 支付", then from 商户平台 → API 安全:
#   1. 商户号                        → WXPAY_MCHID
#   2. An appid bound to this mchid  → WXPAY_APPID
#   3. API 证书序列号                → WXPAY_SERIAL_NO
#   4. 商户私钥 apiclient_key.pem    → WXPAY_PRIVATE_KEY (PEM content or path)
#   5. APIv3 密钥 (32 chars)         → WXPAY_APIV3_KEY
# The platform certificate used to verify callbacks is fetched and cached
# automatically; you can pin it with WXPAY_PLATFORM_CERT/_SERIAL instead.
#
# Once set, the CN pricing page offers WeChat QR checkout alongside Alipay.
#WXPAY_MCHID=
#WXPAY_APPID=
#WXPAY_SERIAL_NO=
#WXPAY_PRIVATE_KEY=
#WXPAY_APIV3_KEY=
#WXPAY_PLATFORM_CERT=
#WXPAY_PLATFORM_CERT_SERIAL=

# --- Mock payment cashier (DEV ONLY) ---
# PAYMENT_MOCK=1 replaces the Alipay/WeChat gateways with a local fake
# cashier page so the full pending → notify → fulfil → success flow runs
# without merchant accounts. Refuses to enable when NODE_ENV=production.
#PAYMENT_MOCK=1

# --- HDA binary ---
# Absolute path to the .hda file that gets delivered after a purchase.
# Defaults to the canonical HDA location on this dev machine.
HDA_FILE_PATH=

# --- Blend assets (lightweight-server knobs) ---
# Target box is 2 GB RAM / 2 vCPU — Blender work is opt-in.
#
# BLEND_RENDER_THUMBNAILS=1 renders a real 2048px thumbnail via Blender.
# Default (unset / 0): a sub-millisecond solid-color placeholder PNG is
# written in pure Node instead. A Blender thumbnail render is the single
# heaviest job in the app (~minutes of CPU + ~1 GB RAM) — leave off on a
# 2 GB box. Only the manifest parse (fixer + parser) runs Blender.
#BLEND_RENDER_THUMBNAILS=0
#
# BLEND_ASSET_EXTRACT_ENABLED=0 disables per-asset zip downloads (each one
# spawns a Blender subprocess). Keep the default ON for feature parity;
# set 0 if you only ship the full pack via baidu pan on this box.
#BLEND_ASSET_EXTRACT_ENABLED=1
#
# Blender executable used by the fixer/parser (required for blend uploads).
#BLENDER_EXE=D:/Blender/blender.exe

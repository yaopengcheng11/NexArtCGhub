# =====================================================================
# CG Resource Hub — API environment
# Copy this file to `.env` (the real config) and fill in your values.
# `.env` is git-ignored.
# =====================================================================

# --- Server ---
PORT=8788
NODE_ENV=development

# --- CORS ---
# Comma-separated list of origins allowed to call this API in dev.
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# Long random string. Used to sign JWTs and to sign HDA download URLs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED at boot — the API refuses to start if this is missing, shorter
# than 32 chars, or contains the placeholder text 'change_me'/'fallback'.
JWT_SECRET=

# --- Invites ---
INVITE_CODE=ethereal-2026

# --- Houdini path doctor tool ---
# Path to the bundled hython executable (Houdini 22.0.368).
HYTHON_PATH=C:\Program Files\Side Effects Software\Houdini 22.0.368\bin\hython.exe
HIP_PATH_DOCTOR_MAX_BYTES=104857600   # 100 MB

# --- Stripe (online payments) ---
# Sign up at https://dashboard.stripe.com/register, toggle to "Test mode",
# then copy keys from https://dashboard.stripe.com/test/apikeys
#
# 1. Get your SECRET key (sk_test_...)  → STRIPE_SECRET_KEY
# 2. Get your PUBLISHABLE key (pk_test_...)  → STRIPE_PUBLISHABLE_KEY
# 3. Add a webhook endpoint pointing to https://<your-host>/api/webhooks/stripe
#    listening for `checkout.session.completed` events, then copy the
#    signing secret (whsec_...)  → STRIPE_WEBHOOK_SECRET
#
# For local testing, use the Stripe CLI to forward webhooks:
#   stripe listen --forward-to http://localhost:8788/api/webhooks/stripe
#   (it prints a whsec_... signing secret to use)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Stripe: regional payment methods (Option A: unified Stripe) ---
# If you used Stripe Atlas to incorporate a US LLC, you can accept both
# card payments (international) and WeChat Pay / Alipay (Chinese customers
# paying cross-border). CNY prices are shown to users whose UI is in
# Chinese; USD for everyone else.
#
# Setup (one-time, in Stripe Dashboard):
#   1. Settings → Payment methods → Activate "WeChat Pay"
#   2. Settings → Payment methods → Activate "Alipay"
#   3. Both support CNY + 10 other currencies; no code change needed.
#
# If STRIPE_SECRET_KEY is empty, all /api/checkout/* routes return 503.
# No additional env vars needed; the currency is chosen by the frontend
# (driven by the i18n locale: 'zh' → CNY, 'en' → USD).

# --- HDA binary ---
# Absolute path to the .hda file that gets delivered after a purchase.
# Defaults to the canonical HDA location on this dev machine.
HDA_FILE_PATH=
